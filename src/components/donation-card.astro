---
interface Props {
  amount: number;
  url: string;
}

const { amount, url } = Astro.props;
---

<div class="panel flex flex-col gap-4 p-5 hover:border-line-strong">
  <h2 class="text-3xl">${amount}<span class="text-sm text-muted">/mo</span></h2>
  <p class="text-sm text-muted">
    Recurring donation funding the next generation of builders
  </p>
  <a href={url} target="_blank" class="btn mt-auto">Donate</a>
</div>
